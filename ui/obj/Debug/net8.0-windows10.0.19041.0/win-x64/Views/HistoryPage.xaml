<Page
    x:Class="BatteryMonitor.UI.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowDefinitions="Auto,Auto,*" Padding="20,16" RowSpacing="12">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="历史管理" Style="{StaticResource AppPageTitleStyle}" />
                <TextBlock x:ConnectionId='10' x:Name="SubtitleText" Text="—" Style="{StaticResource AppPageSubtitleStyle}" />
            </StackPanel>
            <Button x:ConnectionId='9' x:Name="RefreshButton" Grid.Column="1"                       VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="刷新" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource AppKpiCardStyle}">
                <StackPanel Spacing="2">
                    <TextBlock Text="数据库大小" Style="{StaticResource AppCardLabelStyle}" />
                    <TextBlock x:ConnectionId='7' x:Name="KpiSize" Text="—" FontSize="24" FontWeight="Bold" />
                    <TextBlock x:ConnectionId='8' x:Name="KpiSizeSub" Text="history.csv" Style="{StaticResource AppCardFootnoteStyle}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource AppKpiCardStyle}">
                <StackPanel Spacing="2">
                    <TextBlock Text="采样总条数" Style="{StaticResource AppCardLabelStyle}" />
                    <TextBlock x:ConnectionId='6' x:Name="KpiCount" Text="—" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="全部设备合计" Style="{StaticResource AppCardFootnoteStyle}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource AppKpiCardStyle}">
                <StackPanel Spacing="2">
                    <TextBlock Text="设备数" Style="{StaticResource AppCardLabelStyle}" />
                    <TextBlock x:ConnectionId='5' x:Name="KpiDevices" Text="—" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="含已离线的历史设备" Style="{StaticResource AppCardFootnoteStyle}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource AppKpiCardStyle}">
                <StackPanel Spacing="2">
                    <TextBlock Text="最早记录" Style="{StaticResource AppCardLabelStyle}" />
                    <TextBlock x:ConnectionId='3' x:Name="KpiEarliest" Text="—" FontSize="24" FontWeight="Bold" />
                    <TextBlock x:ConnectionId='4' x:Name="KpiEarliestSub" Text="—" Style="{StaticResource AppCardFootnoteStyle}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource AppCardStyle}" Padding="16">
            <Grid RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBlock Grid.Column="0" Text="按设备清理" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="勾选后可批量删除，删除不可恢复"
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
                <ScrollViewer Grid.Row="1">
                    <StackPanel x:ConnectionId='2' x:Name="DeviceRows" Spacing="4" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>

