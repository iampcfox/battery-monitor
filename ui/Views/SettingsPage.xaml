<Page
    x:Class="BatteryMonitor.UI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="RowTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="RowDescStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="RowDividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,4" />
        </Style>
    </Page.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0" Padding="20,16,20,4">
            <StackPanel Spacing="2">
                <TextBlock Text="设置" Style="{StaticResource AppPageTitleStyle}" />
                <TextBlock Text="外观、提醒、数据采集与悬浮窗" Style="{StaticResource AppPageSubtitleStyle}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="20,8,20,16">
            <StackPanel Spacing="20">

                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="3" Height="14" CornerRadius="1.5" VerticalAlignment="Center"
                                Background="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock Text="外观" Style="{StaticResource SectionTitleStyle}" />
                    </StackPanel>
                    <Border Style="{StaticResource CardStyle}">
                        <Grid ColumnDefinitions="*,Auto" Padding="0,12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="界面主题" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock Text="跟随系统或固定深色" Style="{StaticResource RowDescStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="ThemeCombo" Grid.Column="1" Width="160" VerticalAlignment="Center" SelectionChanged="Theme_Changed">
                                <ComboBoxItem Content="跟随系统" Tag="Default" />
                                <ComboBoxItem Content="深色" Tag="Dark" IsSelected="True" />
                                <ComboBoxItem Content="浅色" Tag="Light" />
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="3" Height="14" CornerRadius="1.5" VerticalAlignment="Center"
                                Background="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock Text="提醒" Style="{StaticResource SectionTitleStyle}" />
                    </StackPanel>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Padding="0,12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="低电量提醒阈值" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="低于该电量时弹托盘提醒，0 表示关闭" Style="{StaticResource RowDescStyle}" />
                                </StackPanel>
                                <NumberBox x:Name="ThresholdBox" Grid.Column="1" Value="20" Minimum="0" Maximum="80"
                                           SpinButtonPlacementMode="Inline" Width="160" VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource RowDividerStyle}" />
                            <Grid ColumnDefinitions="*,Auto" Padding="0,12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="剩余时间估算" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="根据近期放电速度估算，并显示在设备列表" Style="{StaticResource RowDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="EstimateToggle" Grid.Column="1" OnContent="开" OffContent="关"
                                              MinWidth="0" IsOn="True" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="3" Height="14" CornerRadius="1.5" VerticalAlignment="Center"
                                Background="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock Text="数据采集" Style="{StaticResource SectionTitleStyle}" />
                    </StackPanel>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Padding="0,12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="统计采样间隔" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="分钟；间隔越小，曲线越细但文件越大" Style="{StaticResource RowDescStyle}" />
                                </StackPanel>
                                <NumberBox x:Name="RecordMinutesBox" Grid.Column="1" Value="5" Minimum="1" Maximum="60"
                                           SpinButtonPlacementMode="Inline" Width="160" VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource RowDividerStyle}" />
                            <Grid ColumnDefinitions="*,Auto" Padding="0,12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="历史保留天数" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="超过天数的记录启动时自动清理" Style="{StaticResource RowDescStyle}" />
                                </StackPanel>
                                <NumberBox x:Name="HistoryDaysBox" Grid.Column="1" Value="30" Minimum="1" Maximum="365"
                                           SpinButtonPlacementMode="Inline" Width="160" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="3" Height="14" CornerRadius="1.5" VerticalAlignment="Center"
                                Background="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock Text="悬浮窗" Style="{StaticResource SectionTitleStyle}" />
                    </StackPanel>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Padding="0,12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="显示温度" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="在悬浮窗和窄条上显示电池温度" Style="{StaticResource RowDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="ShowTempToggle" Grid.Column="1" OnContent="开" OffContent="关"
                                              MinWidth="0" IsOn="True" VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource RowDividerStyle}" />
                            <Grid ColumnDefinitions="*,Auto" Padding="0,12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="显示蓝牙设备" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="显示已连接设备的电量" Style="{StaticResource RowDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="ShowBtToggle" Grid.Column="1" OnContent="开" OffContent="关"
                                              MinWidth="0" IsOn="True" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="20,12"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="SavedText" Grid.Column="0" VerticalAlignment="Center" FontSize="13"
                           Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                <Button Grid.Column="1" Style="{ThemeResource AccentButtonStyle}" Click="Save_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                        <TextBlock Text="保存设置" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
