<Page
    x:Class="BatteryMonitor.UI.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="20,16">
        <StackPanel Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Text="Battery Monitor" FontSize="32" FontWeight="SemiBold" CharacterSpacing="-20" />
                <TextBlock Text="笔记本电量 · 温度 · 蓝牙设备电量" Style="{StaticResource AppPageSubtitleStyle}" />
            </StackPanel>

            <Border Style="{StaticResource AppCardStyle}" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="界面：WinUI 3 (Windows App SDK)" FontSize="14" />
                    <TextBlock Text="数据：本机电池 + WinRT 蓝牙 + 历史 CSV" FontSize="14" />
                    <TextBlock x:Name="VersionText" Text="版本 —" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <TextBlock Text="历史数据与配置与 WinForms 版共用同一目录，两个程序可同时运行。"
                       Style="{StaticResource AppCardFootnoteStyle}" />
        </StackPanel>
    </ScrollViewer>
</Page>
